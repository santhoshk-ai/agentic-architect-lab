# ---- AWS (blocks A, B, D, E) ----
AWS_REGION=us-east-1
NOVA_LITE_PROFILE=us.amazon.nova-2-lite-v1:0     # Converse / tool use (geo profile only; no in-region)
AGENT_MODEL=amazon.nova-pro-v1:0                  # Bedrock Agents (Nova 2 Lite does NOT support Agents; Nova Pro does, in-region us-east-1)

# ---- Block A (fill after deploy; never commit real values) ----
GATEWAY_URL=
GATEWAY_ID=
BEARER_TOKEN=

# ---- Block C ----
GOOGLE_CLOUD_PROJECT=                             # Gemini via ADC only (no API keys)
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=                                     # copy the model ID that worked in labs/03 .env
FOUNDRY_PROJECT_ENDPOINT=                         # https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_DEPLOYMENT=gpt-5-mini

# ---- Block D ----
SAGEMAKER_ROLE_ARN=                               # execution role with AmazonSageMakerFullAccess + S3 access

# ---- LLMOps prices: USD per 1M tokens, from the provider pricing pages (left at 0 = cost column shows 0) ----
PRICE_US_AMAZON_NOVA_2_LITE_V1_0_IN=0
PRICE_US_AMAZON_NOVA_2_LITE_V1_0_OUT=0
PRICE_AMAZON_NOVA_PRO_V1_0_IN=0
PRICE_AMAZON_NOVA_PRO_V1_0_OUT=0
PRICE_GPT_5_MINI_IN=0
PRICE_GPT_5_MINI_OUT=0
