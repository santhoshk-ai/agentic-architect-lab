# Copy to .env (git-ignored). Credentials come from your AWS profile, not this file.
AWS_REGION=us-east-1
AWS_PROFILE=default
LAB_PREFIX=agentic-lab04

# Titan Text Embeddings V2; KB index dimension (256 | 512 | 1024)
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIMS=1024

# Model for RetrieveAndGenerate: inference profile ID, foundation-model ID, or full ARN
GEN_MODEL_ID=us.amazon.nova-2-lite-v1:0
