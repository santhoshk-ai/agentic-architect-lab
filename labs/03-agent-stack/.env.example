# Copy to .env and fill in. Never commit .env.

# ---- Block 1: which model answers (bedrock | gemini | mock)
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL=us.amazon.nova-2-lite-v1:0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
MAX_TURNS=5

# ---- Block 2: retrieval
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-2
EMBED_DIM=768
VECTOR_STORE=memory
PG_DSN=postgresql://lab:lab@localhost:5432/lab
RERANK=bedrock
# default: arn:aws:bedrock:<AWS_REGION>::foundation-model/cohere.rerank-v3-5:0
RERANK_MODEL_ARN=
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# ---- Block 3: agents
MCP_URL=http://127.0.0.1:8000/mcp
MCP_IN_PROCESS=0
A2A_URL=http://127.0.0.1:9999
